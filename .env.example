# Copy to .env; never commit local values. Linux Docker Engine + Compose.
GITLAB_IMAGE=gitlab/gitlab-ce:19.5.1-ce.0@sha256:bb79dc86267c557fd11e7feb0cd9dd506dd02e991ecdd6cae11ca7d7e5d36fc3
RUNNER_IMAGE=gitlab/gitlab-runner:alpine-v19.5.0@sha256:b7dead3b57cd9e5e5d6aedc6c0736c43972af9a24aa19875c2802bc8afcd3978
# Defaults are local-only. The runner reaches GitLab over the Compose network.
GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2224
GITLAB_REGISTRY_PORT=5050
# Small local lab; application builds retain normal host CPU scheduling.
GITLAB_PUMA_WORKERS=2
GITLAB_SIDEKIQ_CONCURRENCY=5
LAB_BUILD_CONCURRENCY=4
# Network for trusted native Docker builds; override for other installations.
LAB_DOCKER_BUILD_NETWORK=host
GITLAB_GROUP=myscoutee
GITLAB_PROJECT=ci
# Local runtime/credentials; init chooses this checkout’s ignored .local/state.
LAB_STATE_DIR=
# Workspace with the catalog's sibling repositories (blank = parent of this repo).
LAB_WORKSPACE_DIR=
# Optional ignored JSON declaration extending examples/variables.json.
LAB_VARIABLES_CONFIG=
# Local paths are inputs to scripts/configure.py, never values to commit.
LAB_RELEASE_TOKEN_FILE=
LAB_NPMRC_FILE=
LAB_GRADLE_PROPERTIES_FILE=
LAB_DOCKER_CONFIG_FILE=
LAB_SIGNING_KEY_FILE=
LAB_FIXTURES=
LAB_MICROSERVICES_REVISION=
LAB_NPM_REGISTRY=https://npm.pkg.github.com
LAB_IMAGE_NAMESPACE=ghcr.io/fssrepository
GITHUB_REPOSITORY_OWNER=fssrepository
VMWARE_INSTALL_CONFIG_FILE=
VMWARE_SIGNING_KEY_FILE=
VMWARE_PUBLIC_KEY_FILE=
VMWARE_KEY_FINGERPRINT=
VMWARE_DEPLOY_FORMAT=
VMWARE_PARTIAL_SERVICES=
VMWARE_EXISTING_INSTALLATION=
# Inputs live in the product repository's ignored .local/private directory.
VMWARE_SSH_PRIVATE_KEY_FILE=
VMWARE_SSH_KNOWN_HOSTS_FILE=
VMWARE_CA_CERT_FILE=
VMWARE_FORWARD_PORTS=
VMWARE_VERIFY_URL=
# Optional GitHub configuration; gh authentication is supplied externally.
GITHUB_REPOSITORY=
GITHUB_TOKEN_FILE=
GITHUB_CI_REPOSITORY=
GITHUB_CI_REF=
GITHUB_CANDIDATE_ROOT=
LAB_GITLAB_URL=http://localhost:8929
# Optional KVM bridge access, enabled only after that bridge exists:
# COMPOSE_FILE=compose.yaml:compose.kvm.yaml
GITLAB_KVM_BIND_ADDRESS=
BACKEND_KAS_ADDRESS=
TEMPLATE_KAS_ADDRESS=
BACKEND_KVM_RUNTIME_CONFIG_FILE=
TEMPLATE_KVM_RUNTIME_CONFIG_FILE=
# Optional GitHub cluster inputs, provisioned by kubernetes.py outside Git:
BACKEND_KUBE_AGENT_TOKEN_FILE=
TEMPLATE_KUBE_AGENT_TOKEN_FILE=

# Managed state for CI KVM jobs; native local operators retain their local backend.
LAB_TERRAFORM_BACKEND=gitlab
LAB_TERRAFORM_STATE_NAME=kvm
BACKEND_MONOLITH_MODE=compose
TEMPLATE_MONOLITH_MODE=compose
BACKEND_SIGNING_KEY_FILE=
TEMPLATE_SIGNING_KEY_FILE=
BACKEND_TERRAFORM_STATE_NAME=kvm
TEMPLATE_TERRAFORM_STATE_NAME=kvm
KVM_GRADLE_OPTS=-Dorg.gradle.jvmargs=-Xmx2g

# Stable ignored state roots owned by the deployed application checkout.
BACKEND_KVM_STATE_ROOT=
TEMPLATE_KVM_STATE_ROOT=

# Optional public-port overrides; defaults live in application config/ci/*.json.
BACKEND_KVM_HTTP_PORT=
BACKEND_KVM_GRAFANA_PORT=
BACKEND_KVM_PROMETHEUS_PORT=
BACKEND_MONOLITH_HTTP_PORT=
BACKEND_MONOLITH_HTTPS_PORT=
BACKEND_MONOLITH_STUN_PORT=
TEMPLATE_KVM_HTTP_PORT=
TEMPLATE_KVM_GRAFANA_PORT=
TEMPLATE_KVM_PROMETHEUS_PORT=
TEMPLATE_MONOLITH_HTTP_PORT=
TEMPLATE_MONOLITH_HTTPS_PORT=
TEMPLATE_MONOLITH_STUN_PORT=

# CI builds finish their Gradle process; no idle build owner blocks VM startup.
LAB_GRADLE_OPTS=-Dorg.gradle.daemon=false

# Template VMware target has independent credentials and configuration.
TEMPLATE_VMWARE_INSTALL_CONFIG_FILE=
TEMPLATE_VMWARE_SIGNING_KEY_FILE=
TEMPLATE_VMWARE_PUBLIC_KEY_FILE=
TEMPLATE_VMWARE_KEY_FINGERPRINT=
TEMPLATE_VMWARE_SSH_PRIVATE_KEY_FILE=
TEMPLATE_VMWARE_SSH_KNOWN_HOSTS_FILE=
TEMPLATE_VMWARE_CA_CERT_FILE=
TEMPLATE_VMWARE_FORWARD_PORTS=
TEMPLATE_VMWARE_VERIFY_URL=
