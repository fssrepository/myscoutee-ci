# Copy to .local/private/runner-host.env (ignored); chmod 600 that file.
# Paths are relative to the CI checkout, or absolute. Values are literal;
# no shell expressions, variable expansion or passwords are evaluated.
RUNNER_USER=myscoutee-ci
RUNNER_OPERATOR=USER
RUNNER_HOME=.local/runner-home
RUNNER_STATE_DIR=.local/state/build-runner
RUNNER_APPLICATION_DIR=../myscoutee-backend
RUNNER_MICROSERVICES_DIR=../myscoutee-microservices
# Existing tool installations: read/execute permission only, no personal dotfiles.
RUNNER_TOOL_DIRS='["/opt/node", "/opt/jdk"]'
RUNNER_JAVA_HOME=/opt/jdk
# Only these app-owned, ignored CI state directories are transferred.
# Match each runtime.json lab.stateDirectory beneath LAB_KVM_STATE_ROOT.
RUNNER_KVM_STATE_DIRS='["../myscoutee-backend/.local/state/myscoutee-microservices/msc129", "../myscoutee-template/.local/state/myscoutee-template/ci"]'
